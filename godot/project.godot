; Godot 4.7 프로젝트 설정 (Phase 5-0 뼈대).
; 이 폴더(godot/)만 Godot 에디터에서 가져온다. 저장소 최상위는 Rust 프로젝트다.

config_version=5

[application]

config/name="Self-Driving Sim"
run/main_scene="res://main.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")

[rendering]

renderer/rendering_method="forward_plus"
